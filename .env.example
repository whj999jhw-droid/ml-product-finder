# CodeBuddy API Key (从 https://www.codebuddy.cn 获取)
CODEBUDDY_API_KEY=

# CodeBuddy Auth Token (可选，与 API Key 二选一)
CODEBUDDY_AUTH_TOKEN=

# 网络环境 (可选: external/internal)
CODEBUDDY_INTERNET_ENVIRONMENT=external

# Base URL (可选)
CODEBUDDY_BASE_URL=

# 服务器端口
PORT=3000

# 手机 APP 推送中转服务地址（后端检测到新订单时 POST 到此地址，再转 FCM/APNs）
# 中转服务与本后端同机运行时用 loopback 即可，无需公网 HTTPS
# 详见 push-gateway/ 与 docs/mobile-push-complete-guide.md
MOBILE_PUSH_WEBHOOK=http://localhost:4100/push
