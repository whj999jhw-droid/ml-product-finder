{
  "name": "ml-product-finder",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "node build-server.mjs",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=true electron .\"",
    "electron:build": "node build-electron.mjs",
    "electron:dist": "node build-electron.mjs"
  },
  "dependencies": {
    "date-holidays": "^3.35.0"
  },
  "devDependencies": {
    "@tdesign-react/aigc": "^0.1.0-alpha.1",
    "@tdesign-react/chat": "^1.0.2",
    "@tencent-ai/agent-sdk": "^0.3.43",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.6.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "https-proxy-agent": "^9.1.0",
    "jimp": "^0.22.12",
    "less": "^4.3.0",
    "localtunnel": "^2.0.2",
    "lucide-react": "^0.563.0",
    "nodemailer": "^6.10.1",
    "postcss": "^8.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "socks-proxy-agent": "^10.1.0",
    "tailwindcss": "^3.4.17",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "uuid": "^9.0.0",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mercadolibre.product-finder",
    "productName": "ML Product Finder",
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    }
  }
}
