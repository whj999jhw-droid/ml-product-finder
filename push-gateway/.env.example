# ===== 极光 JPush（安卓推送，国内推荐，含华为/小米/OPPO/VIVO/魅族厂商通道） =====
# 去 https://www.jiguang.cn 注册 → 创建应用 → 拿到 AppKey 和 Master Secret
#
# 重要：极光「一个包名 = 一个 AppKey」。本项目安卓有两个包名：
#   v1 = com.mercadoprofit        ← 用下面这一套（JPUSH_APP_KEY / JPUSH_MASTER_SECRET）
#   v2 = com.mercadoprofit.v2     ← 需在极光【另建一个应用】，包名填 com.mercadoprofit.v2，
#                                    拿到第二套 AppKey/MasterSecret，填到下面 _V2 这套
# 推送网关会按设备上报的 pkg 字段自动选对应凭证，无需改代码。
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# v2 安卓应用（包名 com.mercadoprofit.v2）的独立极光凭证
JPUSH_APP_KEY_V2=
JPUSH_MASTER_SECRET_V2=

# ===== FCM（安卓备选，需要谷歌服务，国内手机多半收不到，可不配） =====
# FCM_SERVICE_ACCOUNT=./service-account.json
# FCM_PROJECT_ID=

# ===== APNs（苹果推送，必配） =====
# 在 Apple Developer 创建 APNs 鉴权密钥 .p8，放到本目录
APNS_KEY_PATH=./AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.mercadoprofit.ios   # 必须与 iOS App 的 Bundle ID 完全一致（见 project.yml / Xcode 工程）
APNS_PRODUCTION=false   # true=线上 false/空=沙盒

# 监听端口（默认 4100，仅本机 loopback，后端经 MOBILE_PUSH_WEBHOOK 调用）
PORT=4100
